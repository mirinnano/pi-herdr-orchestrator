{
  "name": "pi-herdr-orchestrator",
  "version": "0.2.0",
  "description": "A scoped Pi Extension for coordinating recognized agents in Herdr-managed panes.",
  "keywords": ["pi-package", "pi-extension", "herdr", "agent-orchestration"],
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "pi": {
    "extensions": ["./extensions/herdr-orchestrator.ts", "./extensions/herdr-worker.ts", "./extensions/model-switcher.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "^26.0.0",
    "typebox": "1.3.27",
    "typescript": "^6.0.0"
  },
  "license": "MIT"
}
